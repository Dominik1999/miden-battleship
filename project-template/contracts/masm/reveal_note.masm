use {NoteArgs} from miden::protocol::types
use miden::protocol::active_note
use battleship::account as battleship

# Reveal note: sent by a player to the opponent from the player's game account after the game is
# decided. The opponent consumes it to verify the revealed board commitment.

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Note storage layout: [COMMITMENT(4)].
const COMMITMENT_PTR = STORAGE_PTR
const NUM_STORAGE_ITEMS = 4

# ERRORS
# =================================================================================================

const ERR_REVEAL_NOTE_WRONG_NUM_STORAGE_ITEMS = "reveal note must carry exactly 4 storage items"

# NOTE SCRIPT
# =================================================================================================

#! Verifies the revealed commitment carried by this note on the consuming account.
#!
#! Inputs:  [NOTE_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note does not carry exactly NUM_STORAGE_ITEMS storage items.
#! - battleship::verify_opponent_reveal fails to verify.
#!
#! Invocation: dyncall
@note_script
pub proc main(args: NoteArgs)
    dropw
    # => [pad(16)]

    push.NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS assert.err=ERR_REVEAL_NOTE_WRONG_NUM_STORAGE_ITEMS
    # => [pad(16)]

    # build the verify_opponent_reveal window [COMMITMENT, pad(12)]
    padw padw padw
    push.COMMITMENT_PTR add.3 mem_load
    push.COMMITMENT_PTR add.2 mem_load
    push.COMMITMENT_PTR add.1 mem_load
    push.COMMITMENT_PTR mem_load
    # => [COMMITMENT, pad(12), pad(16)]

    call.battleship::verify_opponent_reveal
    # => [pad(16), pad(16)]

    dropw dropw dropw dropw
    # => [pad(16)]
end
