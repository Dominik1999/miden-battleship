use {NoteArgs} from miden::protocol::types
use miden::protocol::active_note
use battleship::account as battleship

# Accept note: sent by the acceptor back to the challenger from the acceptor's game account.
# The challenger consumes it to receive the acceptance (CHALLENGED -> ACTIVE, expected turn 2).

# CONSTANTS
# =================================================================================================

# Memory base at which the note storage is written by `active_note::get_bounded_storage`.
const STORAGE_PTR = 0

# Note storage layout: [GAME_ID(4), acceptor_prefix, acceptor_suffix, COMMITMENT(4)].
const GAME_ID_PTR = STORAGE_PTR
const ACCEPTOR_PREFIX_PTR = STORAGE_PTR + 4
const ACCEPTOR_SUFFIX_PTR = STORAGE_PTR + 5
const COMMITMENT_PTR = STORAGE_PTR + 6
const NUM_STORAGE_ITEMS = 10

# ERRORS
# =================================================================================================

const ERR_ACCEPT_NOTE_WRONG_NUM_STORAGE_ITEMS = "accept note must carry exactly 10 storage items"

# NOTE SCRIPT
# =================================================================================================

#! Delivers the acceptance carried by this note to the consuming account.
#!
#! Inputs:  [NOTE_ARGS, pad(12)]
#! Outputs: [pad(16)]
#!
#! Panics if:
#! - the note does not carry exactly NUM_STORAGE_ITEMS storage items.
#! - battleship::receive_acceptance fails to verify.
#!
#! Invocation: dyncall
@note_script
pub proc main(args: NoteArgs)
    dropw
    # => [pad(16)]

    push.NUM_STORAGE_ITEMS push.STORAGE_PTR exec.active_note::get_bounded_storage
    # => [num_storage_items, pad(16)]

    eq.NUM_STORAGE_ITEMS assert.err=ERR_ACCEPT_NOTE_WRONG_NUM_STORAGE_ITEMS
    # => [pad(16)]

    # build the receive_acceptance window [GAME_ID, acceptor_suffix, acceptor_prefix, COMMITMENT, pad(6)]
    padw push.0.0
    push.COMMITMENT_PTR add.3 mem_load
    push.COMMITMENT_PTR add.2 mem_load
    push.COMMITMENT_PTR add.1 mem_load
    push.COMMITMENT_PTR mem_load
    mem_load.ACCEPTOR_PREFIX_PTR
    mem_load.ACCEPTOR_SUFFIX_PTR
    push.GAME_ID_PTR add.3 mem_load
    push.GAME_ID_PTR add.2 mem_load
    push.GAME_ID_PTR add.1 mem_load
    push.GAME_ID_PTR mem_load
    # => [GAME_ID, acceptor_suffix, acceptor_prefix, COMMITMENT, pad(6), pad(16)]

    call.battleship::receive_acceptance
    # => [pad(16), pad(16)]

    dropw dropw dropw dropw
    # => [pad(16)]
end
